{
    "name": "server",
    "private": true,
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "build": "tsc",
        "dev": "tsc --noEmit && tsx watch ./src/index.ts",
        "lint": "eslint 'src/**/*.{js,ts}' 'knexfile.ts'",
        "format": "eslint src/**/*.ts --fix",
        "start": "node dist/src/index.js",
        "migrate:make": "node --loader ts-node/esm ./node_modules/.bin/knex --knexfile ./src/common/database/knexfile.ts migrate:make $1",
        "migrate:latest": "node --loader ts-node/esm ./node_modules/.bin/knex --knexfile ./src/common/database/knexfile.ts migrate:latest",
        "migrate:up": "node --loader ts-node/esm ./node_modules/.bin/knex --knexfile ./src/common/database/knexfile.ts migrate:up",
        "migrate:down": "node --loader ts-node/esm ./node_modules/.bin/knex --knexfile ./src/common/database/knexfile.ts migrate:down",
        "seed:run": "node --loader ts-node/esm ./node_modules/.bin/knex --knexfile ./src/common/database/knexfile.ts seed:run"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "cors": "^2.8.5",
        "express": "^4.19.2",
        "knex": "^3.1.0",
        "objection": "^3.1.4",
        "pg": "^8.12.0",
        "swagger-jsdoc": "^6.1.0",
        "swagger-ui-express": "^4.1.6"
    },
    "devDependencies": {
        "@eslint/js": "^9.7.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.14.11",
        "@types/pg": "^8.11.6",
        "@types/supertest": "^6.0.2",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.6",
        "dotenv": "^16.4.5",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "globals": "^15.8.0",
        "jest": "^29.7.0",
        "prettier": "^3.3.3",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.3",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.16.2",
        "typescript": "^5.5.3",
        "typescript-eslint": "^7.16.1"
    }
}
